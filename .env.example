# Public deployments should stay deterministic and free by default.
LIGHTBRINGER_LLM_PROVIDER=mock
LIGHTBRINGER_VIDEO_PROVIDER=mock
PORT=4173

# Enable paid providers deliberately on a private/self-hosted server only.
LIGHTBRINGER_LLM_EXTERNAL_ENABLED=false
LIGHTBRINGER_VIDEO_EXTERNAL_ENABLED=false

# OpenAI Responses API adapter
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Messages API adapter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# BytePlus ModelArk / Seedance task adapter
BYTEPLUS_API_KEY=
BYTEPLUS_SEEDANCE_MODEL=
BYTEPLUS_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Mainland China Volcengine Ark alternative
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_SEEDANCE_MODEL=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Cost and reliability guardrails
LIGHTBRINGER_MAX_INPUT_CHARS=12000
LIGHTBRINGER_MAX_OUTPUT_TOKENS=4000
LIGHTBRINGER_TIMEOUT_MS=120000
LIGHTBRINGER_VIDEO_TIMEOUT_MS=30000

# Legacy single-provider variables remain supported for migration:
# LIGHTBRINGER_PROVIDER, LIGHTBRINGER_EXTERNAL_API_ENABLED,
# LIGHTBRINGER_API_BASE_URL, LIGHTBRINGER_API_KEY, LIGHTBRINGER_MODEL
