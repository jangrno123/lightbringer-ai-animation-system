# The public demo is free and deterministic by default.
LIGHTBRINGER_PROVIDER=mock
PORT=4173

# External calls stay disabled until both values below are changed deliberately.
LIGHTBRINGER_EXTERNAL_API_ENABLED=false
LIGHTBRINGER_API_BASE_URL=https://api.example.com
LIGHTBRINGER_API_KEY=
LIGHTBRINGER_MODEL=your-model-name

# Supported protocols: openai-compatible, anthropic
# LIGHTBRINGER_PROVIDER=openai-compatible

# Cost and reliability guardrails
LIGHTBRINGER_MAX_INPUT_CHARS=12000
LIGHTBRINGER_MAX_OUTPUT_TOKENS=4000
LIGHTBRINGER_TIMEOUT_MS=90000
